# ==================================================================================
# ENVIRONMENT VARIABLES TEMPLATE: .env.example
# ==================================================================================
#
# WHAT IS A .env FILE?
# A `.env` file is a secret notebook on your machine where you configure environment
# variables (like API keys, passwords, and server ports) without hardcoding them into git!
#
# HOW TO USE:
# 1. Copy this file and name the copy `.env`:
#      cp .env.example .env
# 2. Open `.env` and fill in your values (e.g. paste your FINNHUB_API_KEY).
# 3. Docker Compose and Spring Boot will automatically read it!
# ==================================================================================

# ----------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ----------------------------------------------------------------------------------
POSTGRES_DB=quantstream
POSTGRES_USER=quantstream
POSTGRES_PASSWORD=quantstream
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/quantstream
SPRING_DATASOURCE_USERNAME=quantstream
SPRING_DATASOURCE_PASSWORD=quantstream

# ----------------------------------------------------------------------------------
# Apache Kafka Message Broker Configuration
# ----------------------------------------------------------------------------------
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_MARKET_TICKS=market-ticks
KAFKA_CONSUMER_GROUP_ID=quantstream-processing

# ----------------------------------------------------------------------------------
# Processing Pipeline & Worker Concurrency
# ----------------------------------------------------------------------------------
QUEUE_SIZE=1000
WORKER_POOL_SIZE=4
WORKER_POLL_TIMEOUT_MS=500
WORKER_SHUTDOWN_TIMEOUT_MS=5000

# ----------------------------------------------------------------------------------
# Market Data Feed Configuration
# Set MARKET_DATA_MODE=simulation for synthetic Indian NSE stocks.
# Set MARKET_DATA_MODE=live to stream real US equities from Finnhub!
# ----------------------------------------------------------------------------------
MARKET_DATA_MODE=simulation
MARKET_DATA_PROVIDER=finnhub
FINNHUB_API_KEY=
FINNHUB_WEBSOCKET_URL=wss://ws.finnhub.io
# Leave empty to automatically stream all 50 registered liquid US equities, or specify a comma-separated subset (e.g. AAPL,MSFT,NVDA)
LIVE_SYMBOLS=

# ----------------------------------------------------------------------------------
# Market Simulation Parameters (Active when MARKET_DATA_MODE=simulation)
# ----------------------------------------------------------------------------------
SIMULATION_AUTO_START=true
SIMULATION_SEED=20260902
SIMULATION_INTERVAL_MS=500
SIMULATION_SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,SBIN,BHARTIARTL,ITC,KOTAKBANK,LT

# ----------------------------------------------------------------------------------
# Frontend Client Configuration
# ----------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
