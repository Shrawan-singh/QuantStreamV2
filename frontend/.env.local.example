# ==================================================================================
# CLERK AUTHENTICATION CONFIGURATION
# ==================================================================================
#
# To set up Clerk authentication:
# 1. Sign up at https://dashboard.clerk.com/
# 2. Create a new application
# 3. Copy your API keys from the "Developers" section
# 4. Rename this file to .env.local and fill in your keys
#
# NEVER commit .env.local to version control! Only commit .env.local.example
#
# ==================================================================================

# Clerk Publishable Key (safe to expose in client-side code)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Clerk Secret Key (NEVER expose this in client-side code or frontend)
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# Redirect URL after sign-in (optional, defaults to /)
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ==================================================================================
# EXISTING APPLICATION CONFIGURATION
# ==================================================================================

# Frontend Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
